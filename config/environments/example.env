# Copy this file to .env and fill in real values
# Same as .env.example in the root — kept here for config/ organization

APP_ENV=paper
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://trader:password@localhost:5432/trading_engine
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

ALPACA_API_KEY=your-key-here
ALPACA_SECRET_KEY=your-secret-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

POLYGON_API_KEY=your-polygon-key

OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

RISK_MAX_POSITION_PCT=0.10
RISK_MAX_DRAWDOWN_PCT=0.15
RISK_MAX_DAILY_LOSS_PCT=0.03
