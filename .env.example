# =============================================================================
# AI-Native Trading Engine — Environment Configuration Template
# Copy this to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | paper | shadow | live
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://trader:password@localhost:5432/trading_engine
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# --- Message Broker (Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=trading-engine

# --- Broker Integrations ---
# Alpaca (paper trading sandbox)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper endpoint

# Polygon.io (market data)
POLYGON_API_KEY=your-polygon-api-key

# Interactive Brokers (optional)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- AI / LLM ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Observability ---
# Prometheus metrics endpoint
METRICS_PORT=9090

# OpenTelemetry (Jaeger / OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=trading-engine

# PagerDuty (alerts)
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# Slack (notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Risk Engine Defaults (can be overridden per strategy) ---
RISK_MAX_POSITION_PCT=0.10         # max 10% of portfolio in one position
RISK_MAX_PORTFOLIO_VAR_PCT=0.02    # max 2% daily VaR
RISK_MAX_DRAWDOWN_PCT=0.15         # circuit breaker at 15% drawdown
RISK_MAX_DAILY_LOSS_PCT=0.03       # halt trading at 3% daily loss
RISK_CORRELATION_THRESHOLD=0.85    # flag highly correlated positions

# --- Execution ---
EXECUTION_DEFAULT_ORDER_TYPE=LIMIT
EXECUTION_SLIPPAGE_BPS=5           # assumed slippage in basis points
EXECUTION_MAX_PARTICIPATION_RATE=0.10  # max 10% of average volume
