# =============================================================================
# .gitignore — Trading Engine
# =============================================================================

# --- Secrets & credentials (NEVER commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/
env/

# --- Testing ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.coveragerc

# --- Type checking ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- Linting ---
.ruff_cache/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# --- Logs ---
logs/
*.log
*.log.*

# --- Data files (use DVC or S3 for large datasets) ---
data/
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
!tests/fixtures/**/*.pkl

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- Docker ---
docker/data/
docker/volumes/

# --- Alembic ---
# Keep migrations, but ignore compiled cache
alembic/__pycache__/

# --- OS ---
Thumbs.db
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# --- Temporary ---
tmp/
temp/
.tmp/
